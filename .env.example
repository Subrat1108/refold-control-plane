# .env.example — commit this file, never commit .env

# ── Supabase (Phase 6) ───────────────────────────────────────────────────────
# Frontend (safe to expose — anon key is RLS-gated):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-side only (Edge Functions) — NEVER put in the frontend / VITE_*:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# For local dev the URL/keys are printed by `npx supabase start` (well-known
# local dev keys — not secret).

# ── Data source (used from 6.5) ──────────────────────────────────────────────
# One unified app, one login — no VITE_PORTAL (retired in R1, D-048).
# Metrics provider: mock | live (mock is the fallback; see build-spec-v2 § 8)
VITE_DATA_SOURCE=mock

# ── Legacy / mock era (still referenced by the mock provider) ────────────────
VITE_API_BASE_URL=https://api.refold.io
VITE_ENV=production
